{
  "schema_version": 18,
  "status": "inactive_blueprint",
  "purpose": "Language-agnostic API boundary for the separately deployed ANPOS commercial entitlement/distribution service, Community repository-readiness surface, and source-implemented Repository Supervisor OAuth/MCP read-plus-guarded-write runtime.",
  "endpoints": [
    {
      "method": "GET",
      "path": "/version",
      "authentication": "public_read",
      "purpose": "Expose non-secret service/artifact identity so deployment verification can reject stale or wrong commercial artifacts.",
      "required_fields": [
        "service",
        "service_version",
        "source_protocol_version",
        "runtime_contract"
      ],
      "must_not_return_secrets": true,
      "cache_control": "no-store"
    },
    {
      "method": "POST",
      "path": "/webhooks/github/marketplace",
      "authentication": "github_webhook_hmac_sha256",
      "idempotency": "X-GitHub-Delivery with payload-hash binding and retryable delivery state",
      "purpose": "Process verified marketplace_purchase events",
      "must_not_return_secrets": true
    },
    {
      "method": "GET",
      "path": "/setup/github",
      "authentication": "marketplace_setup_redirect_then_explicit_github_app_oauth",
      "purpose": "Receive the GitHub Marketplace Setup URL redirect, treat installation_id as untrusted input, create encrypted short-lived OAuth state and PKCE verifier, then redirect to GitHub App OAuth authorization.",
      "request_oauth_on_install": false,
      "pkce_required": true,
      "state_cookie": "HttpOnly Secure SameSite=Lax encrypted max_10_minutes",
      "must_not_trust_installation_id_before_oauth": true,
      "cache_control": "no-store"
    },
    {
      "method": "GET",
      "path": "/api/auth/github/callback",
      "authentication": "github_app_oauth_code_plus_pkce_plus_encrypted_state",
      "purpose": "Exchange the OAuth code, verify the authenticated GitHub user and their access to the Setup installation, then create an encrypted short-lived browser session.",
      "session_cookie": "HttpOnly Secure SameSite=Lax encrypted max_8_hours",
      "refresh_token_persisted": false,
      "installation_user_access_verification_required": true,
      "cache_control": "no-store"
    },
    {
      "method": "GET",
      "path": "/v1/audit/repositories",
      "authentication": "verified_github_user_access_token_or_encrypted_browser_session",
      "purpose": "List repositories available to the authenticated GitHub user through the selected Marketplace App installation.",
      "installation_session_match_required_for_browser_session": true,
      "response_is_sanitized_repository_metadata_only": true,
      "cache_control": "no-store"
    },
    {
      "method": "POST",
      "path": "/v1/audit/repository",
      "authentication": "verified_github_user_access_token_or_encrypted_browser_session_plus_marketplace_app_installation_permission_verification_on_target_repository",
      "purpose": "Provide the ANPOS Community read-only Repository Readiness / Conformance Audit without requiring a paid entitlement.",
      "requires_active_paid_entitlement": false,
      "request": {
        "repository": "owner/name or https://github.com/owner/name"
      },
      "marketplace_app_repository_permissions": {
        "metadata": "read",
        "single_file": "read"
      },
      "approved_single_file_paths": [
        ".ai/manifest.json",
        "config/protocol/instance.json",
        "config/protocol/version.json",
        "config/quality/quality-policy.json",
        "config/security/control-plane-policy.json",
        "config/github/ruleset-policy.json",
        "config/design/design-assurance.json",
        "config/data/data-governance.json",
        "config/release/release-policy.json",
        "config/operations/operations-policy.json"
      ],
      "application_source_code_read": false,
      "installation_permission_set_verified_before_reads": true,
      "reads_performed_with_authenticated_github_user_token": true,
      "installation_identity_must_match_browser_session": true,
      "requesting_user_repository_access_verification_required": true,
      "rate_limit": "10 requests per 60 seconds per authenticated GitHub user",
      "result_persistence": "not_persisted_by_repository_audit",
      "cache_control": "no-store"
    },
    {
      "method": "GET",
      "path": "/v1/entitlements/current",
      "authentication": "verified_github_user_access_token",
      "purpose": "Return a current signed entitlement. Organization entitlements must be bound to an explicitly assigned GitHub user principal.",
      "response_contains_private_signing_material": false
    },
    {
      "method": "GET",
      "path": "/v1/plugin/entitlements/current",
      "authentication": "verified_github_user_access_token_plus_explicit_account_binding",
      "purpose": "Return server-authoritative plugin capability decisions derived from current Marketplace entitlement state and organization seat assignment where required.",
      "account_binding_header": "X-Anpos-Account-Id",
      "billing_authority": "github_marketplace",
      "returns_signed_entitlement": false,
      "returns_payment_data": false,
      "capability_policy": {
        "community_repository_readiness_audit": "active Community or paid entitlement; no paid feature requirement",
        "repository_supervisor_read": "requires protocol_update_channel and active organization seat when account is Organization",
        "repository_supervisor_write": "requires private_template_access plus protocol_update_channel and active organization seat, but remains fail-closed until write runtime is implemented"
      },
      "cache_control": "private, no-store"
    },
    {
      "method": "GET",
      "path": "/v1/keys",
      "authentication": "public_or_cacheable_read",
      "purpose": "Publish active entitlement verification public keys/key IDs",
      "response_contains_private_signing_material": false
    },
    {
      "method": "GET",
      "path": "/v1/releases/current",
      "authentication": "verified_github_user_access_token_plus_active_protocol_update_channel_entitlement_and_org_seat_when_applicable",
      "purpose": "Return the currently approved certified ANPOS paid release identity after billing reconciliation and deterministic vendor export manifest verification.",
      "requires_entitlement": "protocol_update_channel",
      "vendor_release_ref": "exact_40_character_git_commit_sha_only",
      "manifest": "EXPORT-MANIFEST.json from deterministic template export",
      "manifest_verification_required": true,
      "returns_private_repository_name": false,
      "cache_control": "private, no-store"
    },
    {
      "method": "GET",
      "path": "/v1/template/archive",
      "authentication": "verified_github_user_access_token_plus_active_entitlement_and_org_seat_when_applicable",
      "purpose": "Issue a short-lived private GitHub archive redirect for the same exact manifest-verified immutable paid release without permanently granting repository access.",
      "recommended_distribution_path": true,
      "requires_entitlement": "private_template_access",
      "immutable_vendor_release_ref_required": true,
      "deterministic_export_manifest_verified_before_redirect": true
    },
    {
      "method": "GET",
      "path": "/v1/premium/releases/current",
      "authentication": "verified_github_user_access_token_plus_active_premium_entitlements_and_org_seat_when_applicable",
      "purpose": "Return sanitized metadata for the exact private Premium Pack release after Marketplace reconciliation and verifier-receipt digest binding.",
      "requires_entitlements": [
        "premium_blueprints",
        "premium_provider_adapters"
      ],
      "premium_release_ref": "exact_40_character_git_commit_sha_only",
      "manifest": "ANPOS-PREMIUM-MANIFEST.json",
      "offline_verifier": "scripts/verify_premium_pack.py",
      "manifest_sha256_must_match_verifier_receipt": true,
      "content_set_sha256_must_match_verifier_receipt": true,
      "returns_private_repository_name": false,
      "cache_control": "private, no-store"
    },
    {
      "method": "GET",
      "path": "/v1/premium/archive",
      "authentication": "verified_github_user_access_token_plus_active_premium_entitlements_and_org_seat_when_applicable",
      "purpose": "Issue a short-lived GitHub archive redirect for the same exact immutable Premium Pack revision after manifest and verifier-receipt digest checks.",
      "requires_entitlements": [
        "premium_blueprints",
        "premium_provider_adapters"
      ],
      "immutable_premium_release_ref_required": true,
      "premium_manifest_verified_before_redirect": true,
      "recommended_distribution_path": true
    },
    {
      "method": "GET_POST_DELETE",
      "path": "/v1/seats",
      "authentication": "verified_active_github_organization_admin",
      "purpose": "List, assign, or revoke organization seats with capacity enforcement and active-member verification",
      "requires_members_organization_permission": "read"
    },
    {
      "method": "POST",
      "path": "/v1/provision",
      "authentication": "verified_github_user_access_token_plus_active_entitlement_and_org_seat_when_applicable",
      "idempotency_header": "Idempotency-Key",
      "purpose": "Optional collaborator-based private-template provisioning after server-side entitlement verification",
      "default_enabled": false,
      "requires_active_entitlement": true,
      "must_not_modify_existing_generated_project_on_expiry": true
    },
    {
      "method": "POST",
      "path": "/v1/reconcile",
      "authentication": "operator_or_trusted_runtime_only",
      "purpose": "Reconcile commercial ledger against authenticated billing-provider reality after missed/ambiguous events",
      "customer_callable": false
    },
    {
      "method": "POST",
      "path": "/v1/access/reconcile",
      "authentication": "operator_or_trusted_runtime_only",
      "purpose": "Retry revocation of vendor-template collaborator access after entitlement/seat revocation while preserving access backed by other active grants",
      "customer_callable": false
    },
    {
      "method": "GET",
      "path": "/.well-known/oauth-protected-resource",
      "authentication": "public_metadata",
      "purpose": "Publish the MCP resource URL, authorization-server issuer and currently issuable OAuth scopes.",
      "resource": "{ANPOS_PUBLIC_BASE_URL}/mcp",
      "scopes_supported": [
        "anpos:profile",
        "anpos:repo:read",
        "anpos:repo:write"
      ],
      "write_scope_available": true,
      "cache_control": "public, max-age=300"
    },
    {
      "method": "GET",
      "path": "/.well-known/oauth-authorization-server",
      "authentication": "public_metadata",
      "purpose": "Publish OAuth authorization-code metadata for the Repository Supervisor MCP resource.",
      "grant_types_supported": [
        "authorization_code"
      ],
      "pkce_required": "S256",
      "token_endpoint_auth_methods_supported": [
        "none"
      ],
      "client_id_metadata_document_supported": true,
      "authorization_response_iss_parameter_supported": true,
      "scopes_supported": [
        "anpos:profile",
        "anpos:repo:read",
        "anpos:repo:write"
      ]
    },
    {
      "method": "GET",
      "path": "/oauth/authorize",
      "authentication": "exact_allowlisted_mcp_client_plus_verified_cimd_redirect_binding_plus_resource_binding_then_github_app_oauth",
      "purpose": "Validate MCP client/redirect/resource/scope/PKCE inputs, seal short-lived authorization state, and redirect to GitHub App OAuth.",
      "exact_client_allowlist_required": true,
      "exact_redirect_allowlist_required": true,
      "resource_parameter_must_equal_mcp_resource": true,
      "pkce_required": "S256",
      "state_cookie": "HttpOnly Secure SameSite=Lax encrypted max_10_minutes",
      "cimd_document_fetch_required": true,
      "cimd_fetch_redirects": "forbidden",
      "cimd_fetch_max_bytes": 32768,
      "cimd_fetch_timeout_ms": 5000,
      "cimd_client_id_exact_match_required": true,
      "cimd_redirect_uri_membership_required": true,
      "cimd_authorization_code_grant_required": true,
      "cimd_code_response_type_required": true,
      "cimd_public_client_token_method_required": "none"
    },
    {
      "method": "GET",
      "path": "/api/auth/mcp/github/callback",
      "authentication": "github_app_oauth_code_plus_provider_pkce_plus_encrypted_mcp_state",
      "purpose": "Bind the validated MCP authorization request to the authenticated GitHub principal, issue a replay-safe one-time authorization code, and return issuer-bound success/error response to the validated client redirect.",
      "github_refresh_token_persisted": false,
      "provider_access_token_exposed_to_client": false,
      "authorization_code_ttl_seconds": 300
    },
    {
      "method": "POST",
      "path": "/oauth/token",
      "authentication": "public_oauth_client_with_exact_client_redirect_resource_and_pkce_code_verifier_binding",
      "purpose": "Atomically redeem one one-time authorization code for one short-lived opaque MCP bearer token.",
      "access_token_format": "opaque_random_bearer",
      "access_token_ttl_seconds": "operator_configurable_900_to_28800_default_3600",
      "refresh_token_issued": false,
      "github_provider_token_storage": "encrypted_server_side_only",
      "replay_protection": "authorization_code_consumed_at plus token_hash ledger"
    },
    {
      "method": "POST",
      "path": "/mcp",
      "authentication": "opaque_mcp_bearer_token_for_exact_resource",
      "purpose": "Serve the stateless Repository Supervisor MCP tool surface over Streamable HTTP-compatible request/response POSTs.",
      "modern_protocol": "2026-07-28 server/discover",
      "legacy_protocols": [
        "2025-11-25",
        "2025-06-18",
        "2025-03-26"
      ],
      "implemented_tools": [
        "repository_profile",
        "repository_list_billing_accounts",
        "repository_resolve",
        "repository_audit",
        "repository_get_assurance",
        "repository_plan_anpos_change",
        "repository_resolve_plan_conflicts",
        "repository_apply_anpos_change",
        "repository_open_change_request",
        "repository_get_change_request",
        "repository_get_ci",
        "repository_merge_change_request"
      ],
      "profile_tool_meta": "openai/profile=true",
      "paid_tools_require_explicit_billing_account_id": true,
      "billing_account_id_is_not_authorization": true,
      "server_rechecks_github_account_access_and_entitlement": true,
      "write_tools_exposed": true,
      "max_request_body_bytes": 65536,
      "cache_control": "no-store",
      "write_tool_policy": {
        "plan": "server-issued encrypted plan bound to canonical repository identity, exact expected default-branch head SHA and deterministic plan hash",
        "apply": "Normal plans use one expected-head anpos/* feature-branch commit. bootstrap_empty requires explicit confirmation and may create one deterministic zero-parent .anpos-bootstrap-seed root commit on the configured default branch solely to initialize GitHub, then removes that seed in the sandbox-verified feature-branch commit.",
        "pull_request": "exact applied branch head only",
        "ci": "fresh GitHub check-runs plus legacy statuses for exact planned commit",
        "merge": "destructive host-confirmed tool; fresh entitlement/permission, PR head/base, CI, unchanged default-branch head, repository-policy response and resulting-main verification",
        "resolve_conflicts": "derive a new encrypted immutable plan from the exact conflict-blocked source plan; require exact source plan hash, unchanged target head and verified release, one explicit decision per blocking path, exact target Git object binding, and acknowledgement before replacing migration-reviewed project state"
      },
      "planner_modes": [
        "bounded_change",
        "bootstrap_empty",
        "bootstrap_child",
        "adopt_existing",
        "repair_partial",
        "upgrade_active"
      ],
      "full_planner_apply_available": true,
      "full_planner_apply_status": "sandbox_full_plan_v1_plus_guarded_empty_repository_v1",
      "full_planner_apply_exclusions": [
        "manual_merge_conflicts",
        "migration_review_conflicts"
      ],
      "full_planner_conflict_resolution_available": true,
      "full_planner_conflict_resolution_status": "explicit_resolved_plan_v1",
      "billing_account_discovery": {
        "tool": "repository_list_billing_accounts",
        "candidate_source": "authenticated_user_account_plus_active_organization_seat_assignments",
        "github_membership_reverification_required": true,
        "returns_capability_decisions": true,
        "global_account_enumeration": false,
        "billing_account_id_is_selector_only": true
      },
      "internal_read_e2e_grant": {
        "source": "operator_configured_exact_github_login_plus_expiry",
        "maximum_ttl_hours": 48,
        "billing_evidence": false,
        "marketplace_purchase_created": false,
        "repository_supervisor_read_only": true,
        "planning_or_write_authorized": false,
        "selector": "authenticated_principal_own_github_account_id",
        "remove_after_e2e": true
      }
    },
    {
      "method": "GET",
      "path": "/api/ready/mcp",
      "authentication": "public_readiness_no_secrets",
      "purpose": "Fail closed unless MCP OAuth allowlists, database migration and service connectivity are ready.",
      "write_scope_available": true,
      "cache_control": "no-store"
    },
    {
      "method": "POST",
      "path": "/v1/execute",
      "authentication": "anpos_sandbox_hmac_sha256_exact_body_timestamp_nonce",
      "purpose": "Execute one signed Repository Supervisor transformation inside a Vercel Sandbox Firecracker microVM with deny-all networking and exact artifact output allowlisting.",
      "protocol_version": 2,
      "driver_id": "remote_ephemeral_signed_gateway_v1",
      "request_body_limit_source": "commercial-service/lib/vercel-sandbox-gateway.ts",
      "request_replay_ledger": "sandbox_gateway_request_nonces",
      "request_timestamp_skew_seconds": "operator_configurable_30_to_300_default_120",
      "live_workspace_base_modes": [
        "empty"
      ],
      "protocol_workspace_base_modes_pending_live_certification": [
        "github_commit"
      ],
      "runtime": "python3.13",
      "minimum_python": "3.12",
      "network_policy": "deny-all",
      "environment_variable_forwarding": false,
      "live_execution_timeout_seconds": 240,
      "function_max_duration_seconds": 300,
      "output_path_allowlist_exact": true,
      "input_output_sha256_required": true,
      "workspace_destroy_before_signed_success": true,
      "response_signature": "hmac_sha256_request_id_exact_body_hash",
      "cache_control": "no-store"
    },
    {
      "method": "GET",
      "path": "/api/ready/sandbox",
      "authentication": "public_readiness_no_secrets",
      "purpose": "Report fail-closed source configuration readiness for the signed remote-ephemeral Repository Supervisor sandbox driver without pretending a live gateway probe occurred.",
      "exposes_secret_values": false,
      "live_gateway_probe": false,
      "cache_control": "no-store"
    },
    {
      "method": "POST",
      "path": "/api/ready/sandbox/live",
      "authentication": "vercel_deployment_protection_trusted_oidc_plus_explicit_probe_trigger",
      "purpose": "Run one bounded secret-safe production sandbox live E2E through the configured signed gateway and return only non-secret evidence.",
      "production_only": true,
      "requires_header": "x-anpos-sandbox-live-probe: 1",
      "uses_configured_signing_secret_server_side": true,
      "signing_secret_exposed": false,
      "same_origin_vercel_oidc_forwarding_only": true,
      "verifies": [
        "python_runtime_minimum_3_12",
        "network_deny",
        "request_hmac_acceptance",
        "response_hmac",
        "workspace_destroyed",
        "input_sha256_integrity",
        "exact_output_allowlist",
        "output_sha256_integrity",
        "durable_replay_rejection"
      ],
      "cache_control": "no-store"
    }
  ],
  "cross_cutting_rules": {
    "canonical_subject_is_github_numeric_account_id": true,
    "organization_consumption_requires_explicit_seat_principal": true,
    "authorization_is_server_side": true,
    "repository_reference_is_not_authorization": true,
    "deployment_identity_endpoint_required": true,
    "production_readiness_requires_expected_artifact_identity": true,
    "paid_release_ref_must_be_immutable_commit_sha": true,
    "paid_release_manifest_must_be_verified_before_metadata_or_archive_delivery": true,
    "paid_release_manifest_must_bind_canonical_source_revision_and_tree": true,
    "premium_release_ref_must_be_immutable_commit_sha": true,
    "premium_release_manifest_must_match_offline_verifier_receipt_digests": true,
    "premium_distribution_configuration_required_when_higher_paid_tier_is_activated": true,
    "premium_repository_must_be_distinct_from_private_template_repository": true,
    "premium_source_distribution_plumbing_is_not_premium_payload_or_sale_readiness": true,
    "rate_limiting_required": true,
    "bounded_request_bodies_required": true,
    "structured_audit_logging_required": true,
    "structured_audit_logging_required_for_commercial_mutations": true,
    "sensitive_fields_redacted_from_logs": true,
    "request_ids_required": true,
    "timeouts_and_bounded_retries_required": true,
    "least_privilege_github_app_permissions_required": true,
    "community_repository_audit_must_not_read_application_source": true,
    "community_repository_audit_requires_user_and_installation_authorization": true,
    "community_repository_reads_must_be_user_token_bound": true,
    "community_browser_session_must_be_encrypted_http_only_secure_and_short_lived": true,
    "community_oauth_refresh_token_must_not_be_persisted_in_v1": true,
    "marketplace_setup_installation_id_is_untrusted_until_user_verification": true,
    "source_implementation_is_not_marketplace_activation_evidence": true,
    "no_payment_card_storage_when_processor_handles_payment": true,
    "no_remote_kill_switch_for_generated_customer_projects": true,
    "vendor_template_access_may_be_revoked_without_modifying_generated_customer_projects": true,
    "plugin_capability_authorization_is_server_side": true,
    "plugin_account_binding_requires_authenticated_github_access": true,
    "unimplemented_plugin_capabilities_fail_closed": true,
    "plugin_response_exposes_no_payment_card_or_signing_secret_material": true,
    "mcp_oauth_pkce_s256_required": true,
    "mcp_resource_parameter_binding_required": true,
    "mcp_client_and_redirect_exact_allowlists_required": true,
    "mcp_authorization_codes_single_use_and_short_lived": true,
    "mcp_access_tokens_opaque_short_lived_and_server_side_hashed": true,
    "mcp_github_provider_token_encrypted_server_side_only": true,
    "mcp_profile_identity_must_be_stable_opaque_and_credential_scoped": true,
    "mcp_paid_tool_billing_account_id_is_not_authorization": true,
    "mcp_server_must_reauthorize_github_principal_and_entitlement": true,
    "mcp_transport_source_implementation_is_not_public_deployment_evidence": true,
    "repository_supervisor_uses_dedicated_github_app_role": true,
    "marketplace_app_must_not_be_widened_for_supervisor_writes": true,
    "supervisor_app_must_be_distinct_from_marketplace_and_vendor_apps": true,
    "supervisor_write_plan_must_be_server_issued_and_expected_head_bound": true,
    "supervisor_write_plan_payload_must_be_encrypted_at_rest": true,
    "supervisor_apply_must_use_atomic_git_data_commit": true,
    "supervisor_merge_requires_fresh_ci_and_expected_head_reverification": true,
    "supervisor_merge_must_verify_resulting_default_branch_head": true,
    "supervisor_write_source_implementation_is_not_production_write_e2e": true,
    "sandbox_production_driver_source": "commercial-service/lib/remote-sandbox-driver.ts",
    "sandbox_transport_https_only": true,
    "sandbox_request_signature": "hmac_sha256_exact_body_hash_timestamp_nonce",
    "sandbox_response_signature": "hmac_sha256_request_id_exact_body_hash",
    "sandbox_source_binding": "github_repository_plus_immutable_commit_sha",
    "sandbox_network_default_deny": true,
    "sandbox_workspace_destroy_after_execution_required": true,
    "sandbox_redirects_forbidden": true,
    "sandbox_secret_values_never_in_model_request": true,
    "sandbox_source_ready_is_not_live_gateway_evidence": true,
    "github_runtime_e2e_verifier": "commercial-service/scripts/verify-repository-supervisor-e2e.ts",
    "github_runtime_e2e_live_evidence_contract": "config/runtime/repository-supervisor-e2e.json",
    "github_runtime_e2e_source_harness_is_not_live_evidence": true,
    "github_runtime_e2e_write_requires_disposable_repo_name_and_explicit_confirmation": true,
    "github_runtime_e2e_never_busy_waits_for_ci": true,
    "supervisor_full_planner_source": "commercial-service/lib/repository-supervisor-planner.ts",
    "supervisor_full_planner_verified_release_identity_required": true,
    "supervisor_full_planner_immutable_target_tree_required_for_non_empty_targets": true,
    "supervisor_full_planner_target_only_files_preserved": true,
    "supervisor_full_planner_adoption_collisions_never_auto_overwritten": true,
    "supervisor_full_planner_requirements_83_96_evidence_preserved": true,
