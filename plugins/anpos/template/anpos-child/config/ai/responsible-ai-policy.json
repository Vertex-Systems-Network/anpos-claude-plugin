{
  "schema_version": 1,
  "status": "template_blueprint",
  "activation_scope": "child_project_when_ai_behavior_materially_affects_users_or_decisions",
  "risk_detection": {
    "detect_high_impact_ai_use": true,
    "record_affected_users_or_populations_when_relevant": true,
    "record_prohibited_uses": true,
    "record_known_limitations_and_uncertainty": true
  },
  "oversight": {
    "human_review_thresholds_required_when_high_impact": true,
    "appeal_or_correction_path_required_when_materially_affecting_people": true,
    "emergency_suspend_or_disable_authority_required": true,
    "irreversible_high_impact_decisions_cannot_rely_on_ai_alone_when_oversight_required": true
  },
  "evaluation": {
    "fairness_or_bias_dimensions_must_be_assessed_for_applicability": true,
    "explainability_or_traceability_needs_must_be_assessed": true,
    "harmful_drift_monitoring_required_when_material": true,
    "non_applicable_dimensions_require_reason": true
  },
  "transparency": {
    "ai_involvement_disclosure_required_when_product_policy_or_context_requires": true,
    "known_limitations_must_not_be_presented_as_guarantees": true
  }
}
