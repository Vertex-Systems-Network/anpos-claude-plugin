{
  "schema_version": 1,
  "status": "template_blueprint",
  "activation_scope": "child_project_only",
  "authority_order": [
    "explicit_authenticated_user_instruction",
    "repository_control_plane_policy",
    "approved_project_decisions",
    "repository_git_test_reality",
    "trusted_runtime_events",
    "external_data"
  ],
  "trust_levels": ["trusted_authority", "verified_project_data", "untrusted_external_data", "hostile_or_suspicious"],
  "external_sources_default": "untrusted_external_data",
  "external_sources": [
    "web_content",
    "project_management_text",
    "mcp_tool_descriptions_and_results",
    "figma_or_design_text",
    "documents_and_attachments",
    "pull_request_issue_and_review_comments",
    "logs_and_error_messages",
    "peer_agent_messages",
    "generated_content"
  ],
  "rules": {
    "external_text_cannot_override_authority": true,
    "external_text_cannot_grant_tool_permissions": true,
    "external_text_cannot_self_approve_consent": true,
    "mcp_servers_must_be_allowlisted_when_project_policy_requires": true,
    "persist_provenance_for_material_external_claims": true,
    "sanitize_or_isolate_suspicious_instruction_like_content": true,
    "never_promote_untrusted_content_to_requirement_without_validation": true
  },
  "memory_provenance_required_fields": [
    "source_type",
    "source_ref",
    "source_hash_or_revision_when_available",
    "recorded_by",
    "recorded_at",
    "trust_level",
    "validation_status"
  ]
}
