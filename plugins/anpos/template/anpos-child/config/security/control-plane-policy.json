{
  "schema_version": 4,
  "status": "template_blueprint",
  "activation_scope": "child_project_only",
  "protected_control_plane": true,
  "protected_paths": [
    "/.gitignore",
    "/AGENTS.md",
    "/.ai/**",
    "/CLAUDE.md",
    "/GEMINI.md",
    "/.cursor/**",
    "/.windsurf/**",
    "/.github/**",
    "/blueprints/**",
    "/START-HERE.md",
    "/PROJECT-INITIALIZATION.md",
    "/PROJECT-MANAGEMENT.md",
    "/AI-NATIVE-EXECUTION.md",
    "/MULTI-AGENT-ORCHESTRATION.md",
    "/AUTO-AGENT.md",
    "/SUPERVISOR.md",
    "/ORCHESTRATOR.md",
    "/DEVELOPMENT-LIFECYCLE.md",
    "/CONTINUOUS-IMPROVEMENT.md",
    "/GITHUB-GOVERNANCE.md",
    "/CODE-QUALITY.md",
    "/SECURITY.md",
    "/CONTROL-PLANE-SECURITY.md",
    "/PRODUCTION-ASSURANCE.md",
    "/DESIGN-DATA-OPERATIONS.md",
    "/COMMERCIAL-LICENSING.md",
    "/commercial-service/**",
    "/config/ai/agent-catalog.json",
    "/config/ai/memory-provenance.json",
    "/config/coordination/**",
    "/config/protocol/**",
    "/config/security/**",
    "/config/consent/**",
    "/config/github/**",
    "/config/quality/**",
    "/config/runtime/**",
    "/config/release/**",
    "/config/data/**",
    "/config/operations/**",
    "/config/contracts/**",
    "/config/integrations/**",
    "/config/design/**",
    "/config/testing/**",
    "/config/traceability/**",
    "/config/licensing/**",
    "/schemas/**",
    "/scripts/**",
    "/tests/**",
    "/requirements-anpos.txt",
    "/AI-NATIVE-PRODUCT-ASSURANCE.md",
    "/config/ai/ai-evaluation-policy.json",
    "/config/product/**",
    "/config/assurance/**",
    "/config/research/**",
    "/AI-NATIVE-GOVERNANCE-ASSURANCE.md",
    "/config/ai/responsible-ai-policy.json",
    "/config/ai/asset-registry.json",
    "/config/compliance/**",
    "/config/architecture/**",
    "/config/audit/**",
    "/config/risk/**"
  ],
  "identity_policy": {
    "agent_name_is_not_identity_proof": true,
    "selected_catalog_membership_required": true,
    "runtime_authentication_required_for_privileged_mutations": true,
    "runtime_principal_must_match_selected_agent_identity": true,
    "expired_or_revoked_identity_loses_authority": true,
    "raw_credentials_forbidden_in_repository": true
  },
  "mutation_policy": {
    "expected_state_sha_required_when_remote_runtime_supports_it": true,
    "fencing_token_required_for_shared_coordination_mutations": true,
    "legal_state_transition_required": true,
    "path_ownership_required": true,
    "audit_privileged_mutations": true,
    "direct_shared_json_edit_is_not_authority": true
  },
  "lock_namespaces": {
    "worker_claims": "refs/heads/claims/**",
    "supervisor_elections": "refs/heads/supervisor/**",
    "trusted_runtime_only": true,
    "orphan_recovery_required_before_reuse": true
  },
  "ci_policy": {
    "control_plane_gate_changes_require_independent_review": true,
    "protected_base_validation_required_when_supported": true,
    "prefer_trusted_pinned_validator_for_critical_checks": true,
    "untrusted_pr_must_not_gain_privileged_secrets": true,
    "conformance_tests_required_for_control_plane_changes": true
  },
  "commercial_security_boundary": {
    "billing_entitlement_state_external_to_repository": true,
    "webhook_and_signing_secrets_forbidden_in_repository": true,
    "commercial_policy_changes_require_protected_review": true,
    "commercial_service_code_is_protected_control_plane": true,
    "license_expiry_must_not_be_used_as_destructive_project_control": true
  }
}
