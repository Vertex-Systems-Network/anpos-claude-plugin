{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://anpos.local/schemas/product-analytics.schema.json",
  "title":"ANPOS Product Analytics Policy",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","status","activation_scope","metric_examples","metric_contract","interpretation_rules","feedback_loop"],
  "properties":{
    "schema_version":{"const":1},
    "status":{"type":"string"},
    "activation_scope":{"type":"string"},
    "metric_examples":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true},
    "metric_contract":{
      "type":"object","additionalProperties":false,
      "required":["definition_required","source_of_truth_required","event_or_data_schema_required","privacy_classification_required","collection_purpose_required","retention_policy_required","instrumentation_verification_required","baseline_and_target_when_justified"],
      "properties":{
        "definition_required":{"const":true},
        "source_of_truth_required":{"const":true},
        "event_or_data_schema_required":{"const":true},
        "privacy_classification_required":{"const":true},
        "collection_purpose_required":{"const":true},
        "retention_policy_required":{"const":true},
        "instrumentation_verification_required":{"const":true},
        "baseline_and_target_when_justified":{"const":true}
      }
    },
    "interpretation_rules":{
      "type":"object","additionalProperties":false,
      "required":["deployment_is_not_product_success","synthetic_traffic_is_not_user_outcome_evidence","vanity_metrics_must_not_replace_outcome_metrics","segmentation_and_confounding_caveats_must_be_considered"],
      "properties":{
        "deployment_is_not_product_success":{"const":true},
        "synthetic_traffic_is_not_user_outcome_evidence":{"const":true},
        "vanity_metrics_must_not_replace_outcome_metrics":{"const":true},
        "segmentation_and_confounding_caveats_must_be_considered":{"const":true}
      }
    },
    "feedback_loop":{"type":"string","minLength":1}
  }
}
