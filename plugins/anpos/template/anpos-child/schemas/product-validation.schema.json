{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://anpos.local/schemas/product-validation.schema.json",
  "title":"ANPOS Product Validation Policy",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","status","activation_scope","problem_validation","ux_validation","evidence","skip_rule"],
  "properties":{
    "schema_version":{"const":1},
    "status":{"type":"string"},
    "activation_scope":{"type":"string"},
    "problem_validation":{
      "type":"object","additionalProperties":false,
      "required":["target_users_or_jobs_to_be_done_required","problem_hypotheses_must_separate_evidence_from_assumption","critical_user_journeys_required","success_criteria_required"],
      "properties":{
        "target_users_or_jobs_to_be_done_required":{"const":true},
        "problem_hypotheses_must_separate_evidence_from_assumption":{"const":true},
        "critical_user_journeys_required":{"const":true},
        "success_criteria_required":{"const":true}
      }
    },
    "ux_validation":{
      "type":"object","additionalProperties":false,
      "required":["prototype_or_flow_validation_when_material","usability_tasks_and_observable_signals_required_when_material","accessibility_inclusive_validation_when_applicable","findings_must_link_to_design_or_work_updates"],
      "properties":{
        "prototype_or_flow_validation_when_material":{"const":true},
        "usability_tasks_and_observable_signals_required_when_material":{"const":true},
        "accessibility_inclusive_validation_when_applicable":{"const":true},
        "findings_must_link_to_design_or_work_updates":{"const":true}
      }
    },
    "evidence":{
      "type":"object","additionalProperties":false,
      "required":["source_and_date_required","sample_and_context_must_be_recorded","qualitative_feedback_is_not_automatically_generalizable"],
      "properties":{
        "source_and_date_required":{"const":true},
        "sample_and_context_must_be_recorded":{"const":true},
        "qualitative_feedback_is_not_automatically_generalizable":{"const":true}
      }
    },
    "skip_rule":{
      "type":"object","additionalProperties":false,
      "required":["allowed_for_low_risk_or_non_user_facing_scope","reason_must_be_recorded"],
      "properties":{
        "allowed_for_low_risk_or_non_user_facing_scope":{"const":true},
        "reason_must_be_recorded":{"const":true}
      }
    }
  }
}
