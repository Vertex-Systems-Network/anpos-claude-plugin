{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://anpos.local/schemas/responsible-ai-policy.schema.json",
  "title":"ANPOS Responsible AI Policy",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","status","activation_scope","risk_detection","oversight","evaluation","transparency"],
  "properties":{
    "schema_version":{"const":1},
    "status":{"type":"string"},
    "activation_scope":{"type":"string"},
    "risk_detection":{
      "type":"object","additionalProperties":false,
      "required":["detect_high_impact_ai_use","record_affected_users_or_populations_when_relevant","record_prohibited_uses","record_known_limitations_and_uncertainty"],
      "properties":{
        "detect_high_impact_ai_use":{"const":true},
        "record_affected_users_or_populations_when_relevant":{"const":true},
        "record_prohibited_uses":{"const":true},
        "record_known_limitations_and_uncertainty":{"const":true}
      }
    },
    "oversight":{
      "type":"object","additionalProperties":false,
      "required":["human_review_thresholds_required_when_high_impact","appeal_or_correction_path_required_when_materially_affecting_people","emergency_suspend_or_disable_authority_required","irreversible_high_impact_decisions_cannot_rely_on_ai_alone_when_oversight_required"],
      "properties":{
        "human_review_thresholds_required_when_high_impact":{"const":true},
        "appeal_or_correction_path_required_when_materially_affecting_people":{"const":true},
        "emergency_suspend_or_disable_authority_required":{"const":true},
        "irreversible_high_impact_decisions_cannot_rely_on_ai_alone_when_oversight_required":{"const":true}
      }
    },
    "evaluation":{
      "type":"object","additionalProperties":false,
      "required":["fairness_or_bias_dimensions_must_be_assessed_for_applicability","explainability_or_traceability_needs_must_be_assessed","harmful_drift_monitoring_required_when_material","non_applicable_dimensions_require_reason"],
      "properties":{
        "fairness_or_bias_dimensions_must_be_assessed_for_applicability":{"const":true},
        "explainability_or_traceability_needs_must_be_assessed":{"const":true},
        "harmful_drift_monitoring_required_when_material":{"const":true},
        "non_applicable_dimensions_require_reason":{"const":true}
      }
    },
    "transparency":{
      "type":"object","additionalProperties":false,
      "required":["ai_involvement_disclosure_required_when_product_policy_or_context_requires","known_limitations_must_not_be_presented_as_guarantees"],
      "properties":{
        "ai_involvement_disclosure_required_when_product_policy_or_context_requires":{"const":true},
        "known_limitations_must_not_be_presented_as_guarantees":{"const":true}
      }
    }
  }
}
