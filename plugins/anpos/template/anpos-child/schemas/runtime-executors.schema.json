{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anpos.local/schemas/runtime-executors.schema.json",
  "title": "ANPOS Assurance Runtime Executors",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "activation_scope", "purpose", "executors", "security_rules"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"type": "string"},
    "activation_scope": {"type": "string"},
    "purpose": {"type": "string", "minLength": 1},
    "executors": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "requirement_id", "required_capabilities", "required_inputs", "required_outputs"],
        "properties": {
          "id": {"enum": ["ai_evaluation", "user_product_validation", "product_analytics", "experiment", "progressive_delivery", "engineering_review"]},
          "requirement_id": {"enum": ["REQ-83", "REQ-84", "REQ-85", "REQ-86", "REQ-87", "REQ-88"]},
          "required_capabilities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "required_inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "required_outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    },
    "security_rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
