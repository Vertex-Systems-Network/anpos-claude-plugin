{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anpos.dev/schemas/license-entitlement.schema.json",
  "title": "ANPOS License Entitlement Reference",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "activation_scope",
    "authority",
    "state",
    "license_id",
    "github_account_id",
    "github_account_type",
    "github_login",
    "plan_id",
    "seats",
    "entitlements",
    "issued_at",
    "not_before",
    "expires_at",
    "signed_entitlement",
    "verification",
    "rule"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"type": "string", "minLength": 1},
    "activation_scope": {"type": "string", "minLength": 1},
    "authority": {"const": false},
    "state": {
      "enum": ["unbound", "trial", "active", "grace", "suspended", "cancelled", "expired"]
    },
    "license_id": {"type": ["string", "null"], "minLength": 1},
    "github_account_id": {"type": ["integer", "null"], "minimum": 1},
    "github_account_type": {"type": ["string", "null"], "enum": ["User", "Organization", "Enterprise", null]},
    "github_login": {"type": ["string", "null"], "minLength": 1},
    "plan_id": {"type": ["string", "null"], "minLength": 1},
    "seats": {"type": ["integer", "null"], "minimum": 1},
    "entitlements": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "issued_at": {"type": ["string", "null"], "format": "date-time"},
    "not_before": {"type": ["string", "null"], "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "signed_entitlement": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format_version",
            "issuer",
            "subject",
            "license_id",
            "plan_id",
            "seats",
            "entitlements",
            "issued_at",
            "not_before",
            "expires_at",
            "jti",
            "key_id",
            "algorithm",
            "signature"
          ],
          "properties": {
            "format_version": {"enum": [1, 2]},
            "issuer": {"type": "string", "minLength": 1},
            "subject": {
              "type": "object",
              "additionalProperties": false,
              "required": ["github_account_id", "github_account_type", "github_login"],
              "properties": {
                "github_account_id": {"type": "integer", "minimum": 1},
                "github_account_type": {"enum": ["User", "Organization", "Enterprise"]},
                "github_login": {"type": "string", "minLength": 1}
              }
            },
            "principal": {
              "type": "object",
              "additionalProperties": false,
              "required": ["github_user_id", "github_login"],
              "properties": {
                "github_user_id": {"type": "integer", "minimum": 1},
                "github_login": {"type": "string", "minLength": 1}
              }
            },
            "license_id": {"type": "string", "minLength": 1},
            "plan_id": {"type": "string", "minLength": 1},
            "seats": {"type": ["integer", "null"], "minimum": 1},
            "entitlements": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
            "issued_at": {"type": "string", "format": "date-time"},
            "not_before": {"type": "string", "format": "date-time"},
            "expires_at": {"type": ["string", "null"], "format": "date-time"},
            "jti": {"type": "string", "minLength": 8},
            "key_id": {"type": "string", "minLength": 1},
            "algorithm": {"enum": ["Ed25519", "ES256", "RS256"]},
            "signature": {"type": "string", "minLength": 16}
          },
          "allOf": [
            {
              "if": {"properties": {"format_version": {"const": 2}}, "required": ["format_version"]},
              "then": {
                "required": ["principal"],
                "properties": {
                  "subject": {
                    "properties": {"github_account_type": {"const": "Organization"}}
                  }
                }
              }
            },
            {
              "if": {"properties": {"format_version": {"const": 1}}, "required": ["format_version"]},
              "then": {"not": {"required": ["principal"]}}
            }
          ]
        }
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "verified_at", "verifier", "envelope_hash"],
      "properties": {
        "status": {"enum": ["not_verified", "verified", "rejected", "stale"]},
        "verified_at": {"type": ["string", "null"], "format": "date-time"},
        "verifier": {"type": ["string", "null"]},
        "envelope_hash": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"}
      }
    },
    "rule": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "unbound"}}, "required": ["state"]},
      "then": {
        "properties": {
          "license_id": {"type": "null"},
          "github_account_id": {"type": "null"},
          "plan_id": {"type": "null"},
          "signed_entitlement": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"state": {"enum": ["trial", "active", "grace"]}}, "required": ["state"]},
      "then": {
        "required": ["license_id", "github_account_id", "plan_id", "signed_entitlement"],
        "properties": {
          "license_id": {"type": "string", "minLength": 1},
          "github_account_id": {"type": "integer", "minimum": 1},
          "plan_id": {"type": "string", "minLength": 1},
          "signed_entitlement": {"type": "object"}
        }
      }
    }
  ],
  "additionalProperties": false
}
