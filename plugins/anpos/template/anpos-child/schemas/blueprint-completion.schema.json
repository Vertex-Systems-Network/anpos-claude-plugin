{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anpos.local/schemas/blueprint-completion.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "activation_scope",
    "protocol_version",
    "requirement_range",
    "requirements",
    "closure_rules"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "const": "baseline_complete"
    },
    "activation_scope": {
      "const": "canonical_source_blueprint_closure"
    },
    "protocol_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "requirement_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first",
        "last",
        "count"
      ],
      "properties": {
        "first": {
          "const": 1
        },
        "last": {
          "const": 96
        },
        "count": {
          "const": 96
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 96,
      "maxItems": 96,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "domain",
          "authoritative_docs",
          "machine_controls",
          "verification_refs",
          "coverage_status",
          "runtime_evidence_required_in_child"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "pattern": "^REQ-(?:0[1-9]|[1-8][0-9]|9[0-6])$"
          },
          "domain": {
            "enum": [
              "core_project_lifecycle",
              "control_plane_security",
              "production_assurance",
              "design_data_operations",
              "commercial_distribution",
              "ai_native_product_assurance",
              "ai_native_governance_assurance"
            ]
          },
          "authoritative_docs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "machine_controls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "verification_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "coverage_status": {
            "const": "covered_by_blueprint"
          },
          "runtime_evidence_required_in_child": {
            "const": true
          }
        }
      }
    },
    "closure_rules": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
