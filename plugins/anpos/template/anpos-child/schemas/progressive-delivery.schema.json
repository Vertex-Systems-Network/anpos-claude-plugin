{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://anpos.local/schemas/progressive-delivery.schema.json",
  "title":"ANPOS Progressive Delivery Policy",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","status","activation_scope","supported_strategies","required_controls_when_applicable","feature_flag_policy"],
  "properties":{
    "schema_version":{"const":1},
    "status":{"type":"string"},
    "activation_scope":{"type":"string"},
    "supported_strategies":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true},
    "required_controls_when_applicable":{
      "type":"object","additionalProperties":false,
      "required":["selected_rollout_strategy_recorded","health_and_error_guardrails","rollback_or_stop_thresholds","mixed_version_migration_compatibility","kill_switch_or_emergency_disable_when_justified","post_release_verification"],
      "properties":{
        "selected_rollout_strategy_recorded":{"const":true},
        "health_and_error_guardrails":{"const":true},
        "rollback_or_stop_thresholds":{"const":true},
        "mixed_version_migration_compatibility":{"const":true},
        "kill_switch_or_emergency_disable_when_justified":{"const":true},
        "post_release_verification":{"const":true}
      }
    },
    "feature_flag_policy":{
      "type":"object","additionalProperties":false,
      "required":["owner_required","purpose_required","cleanup_or_review_date_required","client_side_flag_is_not_authorization_boundary"],
      "properties":{
        "owner_required":{"const":true},
        "purpose_required":{"const":true},
        "cleanup_or_review_date_required":{"const":true},
        "client_side_flag_is_not_authorization_boundary":{"const":true}
      }
    }
  }
}
