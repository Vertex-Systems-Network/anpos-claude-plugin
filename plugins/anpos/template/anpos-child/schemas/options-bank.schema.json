{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anpos.local/schemas/options-bank.schema.json",
  "title": "ANPOS Options Bank",
  "type": "object",
  "required": [
    "schema_version",
    "options",
    "status_values",
    "option_template"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "description",
          "status",
          "requirement_source",
          "dependencies",
          "conflicts"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^OPT-[A-Z0-9][A-Z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "candidate",
              "selected",
              "rejected",
              "deferred",
              "deprecated"
            ]
          },
          "requirement_source": {
            "type": "array"
          },
          "priority": {
            "type": [
              "integer",
              "null"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^OPT-[A-Z0-9][A-Z0-9-]*$"
            },
            "uniqueItems": true
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^OPT-[A-Z0-9][A-Z0-9-]*$"
            },
            "uniqueItems": true
          },
          "rationale": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "selected",
                    "rejected",
                    "deferred"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "rationale": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "rationale"
              ]
            }
          }
        ]
      }
    },
    "status_values": {
      "const": [
        "candidate",
        "selected",
        "rejected",
        "deferred",
        "deprecated"
      ]
    },
    "option_template": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
