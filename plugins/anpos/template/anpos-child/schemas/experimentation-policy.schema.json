{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://anpos.local/schemas/experimentation-policy.schema.json",
  "title":"ANPOS Experimentation Policy",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","status","activation_scope","experiment_contract","allowed_decisions","supported_modes","safety"],
  "properties":{
    "schema_version":{"const":1},
    "status":{"type":"string"},
    "activation_scope":{"type":"string"},
    "experiment_contract":{"type":"array","minItems":8,"items":{"type":"string","minLength":1},"uniqueItems":true},
    "allowed_decisions":{"type":"array","contains":{"const":"inconclusive"},"items":{"enum":["adopt","revise","reject","inconclusive"]},"uniqueItems":true},
    "supported_modes":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true},
    "safety":{
      "type":"object","additionalProperties":false,
      "required":["no_security_or_privacy_weakening_for_experiment","no_material_undisclosed_user_risk","legal_or_consent_requirements_cannot_be_bypassed"],
      "properties":{
        "no_security_or_privacy_weakening_for_experiment":{"const":true},
        "no_material_undisclosed_user_risk":{"const":true},
        "legal_or_consent_requirements_cannot_be_bypassed":{"const":true}
      }
    }
  }
}
