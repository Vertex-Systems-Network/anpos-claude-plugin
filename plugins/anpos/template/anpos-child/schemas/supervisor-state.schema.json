{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anpos.local/schemas/supervisor-state.schema.json",
  "title": "ANPOS Supervisor State",
  "type": "object",
  "required": ["schema_version", "coordination_epoch", "supervisor", "merge_generation", "status"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 4},
    "coordination_epoch": {"type": "integer", "minimum": 0},
    "merge_generation": {"type": "integer", "minimum": 0},
    "last_pm_sync_at": {"type": ["string", "null"]},
    "status": {"enum": ["template_unassigned", "unassigned", "active", "expired", "relinquished"]},
    "supervisor": {
      "type": "object",
      "required": ["status", "agent_id", "identity_ref", "heartbeat_at", "lease_id", "lease_status", "lease_expires_at", "fencing_token", "election_ref"],
      "properties": {
        "status": {"enum": ["unassigned", "active", "expired", "relinquished"]},
        "agent_id": {"type": ["string", "null"]},
        "agent_type": {"type": ["string", "null"]},
        "identity_ref": {"type": ["string", "null"]},
        "heartbeat_at": {"type": ["string", "null"]},
        "lease_id": {"type": ["string", "null"]},
        "lease_status": {"enum": ["not_acquired", "active", "expired", "released", "revoked", "orphaned", "recovered"]},
        "lease_expires_at": {"type": ["string", "null"]},
        "fencing_token": {"type": ["string", "null"]},
        "election_ref": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "active"}}},
          "then": {
            "required": ["agent_id", "identity_ref", "heartbeat_at", "lease_id", "lease_expires_at", "fencing_token", "election_ref"],
            "properties": {"lease_status": {"const": "active"}}
          }
        }
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
